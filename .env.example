# AI provider key (server-side only, never exposed to the client).
# default provider is xAI (grok-4.20-0309-non-reasoning) over its OpenAI-compatible endpoint.
XAI_API_KEY=your_xai_api_key_here

# personal access token for the generate endpoint (server-side only, required).
# generation is denied for everyone when this is unset (fail closed). pick a long
# random value, e.g. `openssl rand -hex 24`, and set the same value in Vercel.
AUTH_TOKEN=pick_a_long_random_password

# optional: point at a different OpenAI-compatible provider without code changes.
# AI_API_KEY is used if XAI_API_KEY is not set.
# AI_API_KEY=your_provider_key_here
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile
